# Base da API. Enquanto VITE_USE_MOCKS=true nada sai da maquina:
# as chamadas do axios sao interceptadas pelo adapter em src/mocks/adapter.ts.
VITE_API_URL=http://localhost:3333/api

# true  -> dados mockados em memoria (MVP atual)
# false -> axios fala com VITE_API_URL de verdade
VITE_USE_MOCKS=true

# Latencia artificial das respostas mockadas (ms) - deixa loading/skeleton visiveis
VITE_MOCK_LATENCY=450

VITE_APP_NAME=OrbitPlay
