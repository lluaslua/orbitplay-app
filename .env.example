# Base da API (orbitplay-api, `npm run start:dev`). Com VITE_USE_MOCKS=true nada
# sai da maquina: as chamadas do axios caem no adapter em src/mocks/adapter.ts.
VITE_API_URL=http://localhost:3333/api

# false -> axios fala com VITE_API_URL de verdade (padrao: fluxo completo)
# true  -> dados mockados em memoria (so as telas antigas; cadastro, build e
#          pagamento nao tem mock)
VITE_USE_MOCKS=false

# Latencia artificial das respostas mockadas (ms) - deixa loading/skeleton visiveis
VITE_MOCK_LATENCY=450

VITE_APP_NAME=OrbitPlay
